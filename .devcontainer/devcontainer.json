{
  "name": "ABC Prediction Platform",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "vscode",
  "forwardPorts": [8000, 5173],
  "portsAttributes": {
    "8000": {
      "label": "FastAPI"
    },
    "5173": {
      "label": "Vite"
    }
  },
  "customizations": {
